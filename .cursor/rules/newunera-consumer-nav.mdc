function handleNetworkBadgeKey(event) {
    if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault(); toggleNetworkDropdown(event);
    } else if (event.key === 'Escape') {
        closeNetworkDropdown(); event.currentTarget.focus();
    } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        var dd = document.getElementById('networkDropdown');
        if (!dd) return;
        if (!dd.classList.contains('show')) {
            var b = event.currentTarget; b.classList.add('open'); b.setAttribute('aria-expanded', 'true'); dd.classList.add('show');
        }
        var fo = dd.querySelector('.network-option-nav'); if (fo) fo.focus();
    }
}
function handleNetworkOptionKey(event) {
    var options = Array.from(document.querySelectorAll('#networkDropdown .network-option-nav'));
    var idx = options.indexOf(event.currentTarget);
    if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); event.currentTarget.click(); }
    else if (event.key === 'Escape') { event.preventDefault(); closeNetworkDropdown(); var b2 = document.querySelector('.nav-network-badge'); if (b2) b2.focus(); }
    else if (event.key === 'ArrowDown') { event.preventDefault(); var nx = options[idx + 1]; if (nx) nx.focus(); }
    else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (idx === 0) { var b3 = document.querySelector('.nav-network-badge'); if (b3) b3.focus(); }
        else { var pv = options[idx - 1]; if (pv) pv.focus(); }
    }
}

